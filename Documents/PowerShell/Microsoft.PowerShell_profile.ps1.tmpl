{{ template "aliases_ps1" . }}
# python3 → Windows App Execution Alias is a Store stub; point it at the real python
Set-Alias python3 python

# chezmoi apply — re-sources the profile automatically after apply
function czapply { Write-Host "edited a file directly? run: czsrc ~/.thatfile"; chezmoi apply -v; . $PROFILE }
function czcd { Set-Location (chezmoi source-path) }
Set-Alias -Name cdcz -Value czcd

Remove-Variable _cacheDir -ErrorAction SilentlyContinue
Remove-Variable _isInteractiveShell -ErrorAction SilentlyContinue
