<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.dev-cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims/python3</string>
    <string>{{ .chezmoi.homeDir | html }}/.local/bin/dev-cleanup</string>
    <string>--scheduled</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir | html }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>MISE_AUTO_INSTALL</key>
    <string>0</string>
    <key>MISE_NOT_FOUND_AUTO_INSTALL</key>
    <string>0</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
