<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.opencode</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims/opencode</string>
    <string>serve</string>
    <string>--service</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir | html }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims:{{ .chezmoi.homeDir | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir | html }}/Library/Logs/opencode-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir | html }}/Library/Logs/opencode-launchd.log</string>
</dict>
</plist>
