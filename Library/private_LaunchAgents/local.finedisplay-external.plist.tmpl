{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "hostname") -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.finedisplay-external</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir | html }}/.local/libexec/local.finedisplay-external</string>
  </array>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
{{- end }}
