{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "hostname") -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.mus-music-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims/python3</string>
    <string>{{ .chezmoi.homeDir | html }}/.local/bin/mus-music-sync</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir | html }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>MISE_AUTO_INSTALL</key>
    <string>0</string>
    <key>MISE_NOT_FOUND_AUTO_INSTALL</key>
    <string>0</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
{{- end }}
