#!/usr/bin/env sh
set -eu
listen_address=$(netbird status --ipv4)
if [ -z "$listen_address" ]; then
  printf '%s\n' 'Cannot determine the local NetBird address.' >&2
  exit 1
fi

# Service: {{ include "dot_local/share/systemd/user/opencode.service" | sha256sum }}
# OpenCode: {{ regexFind `(?m)^"npm:@opencode/cli"[^\r\n]*` (include "dot_config/mise/config.toml.tmpl") | sha256sum }}
opencode="$HOME/.local/share/mise/shims/opencode"
if [ ! -x "$opencode" ]; then
  mise install npm:@opencode/cli
fi
{{ template "opencode_idle_guard_posix" . }}
mise install npm:@opencode/cli
# Transfer any automatically started daemon to systemd supervision.
systemctl --user daemon-reload
systemctl --user stop opencode.service
"$opencode" service stop
if [ "$("$opencode" service get hostname)" != "$listen_address" ]; then
  "$opencode" service set hostname "$listen_address"
fi
if [ "$("$opencode" service get port)" != "49374" ]; then
  "$opencode" service set port 49374
fi
systemctl --user enable --now opencode.service
