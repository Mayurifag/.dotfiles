{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Service: {{ include "dot_local/share/launchd/local.netbird-loopback.plist" | sha256sum }}
source="$HOME/.local/share/launchd/local.netbird-loopback.plist"
target="/Library/LaunchDaemons/local.netbird-loopback.plist"
plutil -lint "$source"
if ! cmp -s "$source" "$target"; then
  /usr/bin/osascript -e 'on run argv
    do shell script "/usr/bin/install -o root -g wheel -m 644 " & quoted form of (item 1 of argv) & " /Library/LaunchDaemons/local.netbird-loopback.plist && { /bin/launchctl bootout system/local.netbird-loopback 2>/dev/null || true; } && /bin/launchctl bootstrap system /Library/LaunchDaemons/local.netbird-loopback.plist" with administrator privileges
  end run' "$source"
fi
{{- end }}
