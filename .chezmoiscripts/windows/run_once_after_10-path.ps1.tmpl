{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

Write-Host '[chezmoi] running windows/10-path'

$dirs = @(
    "$env:USERPROFILE\.cargo\bin",
    "$env:USERPROFILE\.local\espanso_managed_bins",
    "C:\Program Files\Git\usr\bin",
    "C:\Program Files (x86)\GnuWin32\bin",
    "$env:LOCALAPPDATA\Microsoft\WinGet\Packages\Google.PlatformTools_Microsoft.Winget.Source_8wekyb3d8bbwe\platform-tools"
)

$current = [System.Environment]::GetEnvironmentVariable('PATH', 'User')
$entries = $current -split ';' | Where-Object { $_ -ne '' }
$newEntries = $entries | Where-Object { $dirs -inotcontains $_ }
$newEntries = $dirs + $newEntries

# Keep mise shims ahead of WindowsApps aliases without reordering other entries.
$miseShims = "$env:LOCALAPPDATA\mise\shims"
$windowsApps = "$env:LOCALAPPDATA\Microsoft\WindowsApps"
$shimPlaced = $false
$newEntries = @(foreach ($entry in $newEntries) {
    if ($entry.TrimEnd('\') -ieq $miseShims) {
        if ($shimPlaced) { continue }
        $shimPlaced = $true
    } elseif (-not $shimPlaced -and $entry.TrimEnd('\') -ieq $windowsApps) {
        $miseShims
        $shimPlaced = $true
    }
    $entry
})
if (-not $shimPlaced) { $newEntries += $miseShims }

$newPath = $newEntries -join ';'
$oldPath = $entries -join ';'

if ($newPath -ine $oldPath) {
    [System.Environment]::SetEnvironmentVariable('PATH', $newPath, 'User')
    Write-Host '[path] User PATH updated.'
} else {
    Write-Host '[path] User PATH already up to date.'
}
{{- end }}
