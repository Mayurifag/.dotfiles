{{- if and (eq .chezmoi.os "windows") (eq .chezmoi.hostname "DESKTOP-7DQ9CMG") -}}
#Requires -Version 7.4
#Requires -RunAsAdministrator
$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $true

# OpenCode: {{ regexFind `(?m)^"npm:@opencode/cli"[^\r\n]*` (include "dot_config/mise/config.toml.tmpl") | sha256sum }}
mise install npm:@opencode/cli
$opencode = Join-Path (& mise where npm:@opencode/cli) 'node_modules/@opencode/cli/bin/opencode.exe'
$taskName = 'OpenCode Server'

$status = (& $opencode service status | Out-String).Trim()
if ($status -match '^https?://') {
    $active = (& $opencode api get /api/session/active | ConvertFrom-Json).data
    if ($null -eq $active -or $active -isnot [PSCustomObject]) {
        throw 'Cannot verify OpenCode sessions; leaving the service running.'
    }
    if (@($active.PSObject.Properties).Count -gt 0) {
        throw 'OpenCode has active sessions; retry when idle.'
    }
} elseif ($status -ne 'stopped') {
    throw 'Cannot verify OpenCode service status; leaving it running.'
}

& $opencode service stop
Get-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue | Stop-ScheduledTask
& $opencode service set hostname 100.113.95.177
& $opencode service set port 49374
& $opencode service set remote false

$ruleName = 'OpenCode-NetBird-Proxy'
Get-NetFirewallRule -Name $ruleName -ErrorAction SilentlyContinue | Remove-NetFirewallRule
New-NetFirewallRule -Name $ruleName -DisplayName 'OpenCode from homelab proxy only' `
    -Direction Inbound -Action Allow -Protocol TCP -LocalPort 49374 `
    -LocalAddress 100.113.95.177 -RemoteAddress 100.113.201.147 -Program $opencode -Profile Any | Out-Null

$action = New-ScheduledTaskAction -Execute $opencode -Argument 'serve --service' -WorkingDirectory $HOME
$principal = New-ScheduledTaskPrincipal -UserId ([Security.Principal.WindowsIdentity]::GetCurrent().Name) -LogonType S4U -RunLevel Limited
$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries `
    -ExecutionTimeLimit ([TimeSpan]::Zero) -RestartCount 99 -RestartInterval (New-TimeSpan -Minutes 1) -StartWhenAvailable
Register-ScheduledTask -TaskName $taskName -Action $action -Principal $principal -Settings $settings `
    -Trigger @((New-ScheduledTaskTrigger -AtStartup), (New-ScheduledTaskTrigger -AtLogOn -User $principal.UserId)) -Force | Out-Null
Start-ScheduledTask -TaskName $taskName
{{- end }}
