{{- if eq .chezmoi.os "windows" -}}
Write-Host '[chezmoi] running windows/backup'

$script = Join-Path $env:USERPROFILE '.local\share\chezmoi\windows\windhawk\backup.ps1'

if (-not (Test-Path 'C:\Program Files\Windhawk\windhawk.exe')) {
    Write-Host '[windhawk-backup] Not installed - skipping.' -ForegroundColor Yellow
} else {
    & $script -Quiet
    if ($LASTEXITCODE -ne 0) {
        Write-Host "[windhawk-backup] failed (exit $LASTEXITCODE)" -ForegroundColor Yellow
    } else {
        Write-Host '[windhawk-backup] OK' -ForegroundColor Green
    }
}
{{- end }}
