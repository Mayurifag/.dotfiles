{{- if eq .chezmoi.os "windows" -}}
#Requires -Version 7.4

$python = Join-Path $env:LOCALAPPDATA 'mise\shims\python.exe'
$nas = Join-Path $env:USERPROFILE '.local\bin\nas'
if (-not (Test-Path $python) -or -not (Test-Path $nas)) {
    Write-Warning 'NAS drive not mapped: Python or the NAS launcher is missing.'
    return
}

try {
    & $python $nas --mount
    if ($LASTEXITCODE -ne 0) {
        Write-Warning 'NAS drive was not mapped. Check the message above; retry with nas --mount.'
    }
} catch {
    Write-Warning "NAS drive was not mapped: $($_.Exception.Message)"
}
{{- end }}
