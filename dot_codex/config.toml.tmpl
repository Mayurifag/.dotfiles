approval_policy = "never"
sandbox_mode = "danger-full-access"
allow_login_shell = false
model_reasoning_effort = {{ .aiModels.usual.effort | toJson }}
model = {{ .aiModels.usual.id | toJson }}
{{- if eq .aiModels.usual.speed "fast" }}
service_tier = "fast"
{{- end }}
personality = "none"
plan_mode_reasoning_effort = {{ .aiModels.usual.planEffort | toJson }}
suppress_unstable_features_warning = true

[analytics]
enabled = false

[features]
apps = false
fast_mode = true
shell_snapshot = false
undo = true

{{- if eq .chezmoi.os "windows" }}
[windows]
sandbox = "elevated"

{{- end }}

[tui]
status_line = [
  "model-with-reasoning",
  "project-root",
  "git-branch",
  "context-used",
  "total-input-tokens",
  "total-output-tokens",
  "session-id",
]
theme = "dracula"

[mcp_servers.docmost]
command = "npx"
args = ["-y", "@wisflux/docmost-local-mcp@0.9.2", "--base-url=https://doc.nnnnn.cfd"]
startup_timeout_sec = 60
tool_timeout_sec = 180
