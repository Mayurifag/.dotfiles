status=$("$opencode" service status)
case "$status" in
  stopped) ;;
  http://* | https://*)
    printf '%s\n' 'OpenCode is running; configure the service after stopping it.' >&2
    exit 1
    ;;
  *)
    printf '%s\n' 'Cannot verify OpenCode service status; leaving it running.' >&2
    exit 1
    ;;
esac
processes=$(ps -axo comm=)
if printf '%s\n' "$processes" | grep -Eq '(^|/)(opencode|opencode-pty)$'; then
  printf '%s\n' 'OpenCode or its persistent terminals may be in use; leaving them alone.' >&2
  exit 1
fi
