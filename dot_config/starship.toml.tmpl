# Starship — cross-shell prompt config
# Managed by chezmoi → deploys to ~/.config/starship.toml

{{ if eq .chezmoi.os "windows" -}}
format = "$character$directory\u001b7$fill$cmd_duration\u001b8"
{{- else -}}
format = "$character$directory"
right_format = "$cmd_duration"
{{- end }}
add_newline = false

[character]
success_symbol = "[▲](white)"
error_symbol = "[△](red)"

[directory]
home_symbol = "~"
truncation_length = 4
truncate_to_repo = false

[cmd_duration]
min_time = 2_000
format = "[$duration]($style) "

{{ if eq .chezmoi.os "windows" -}}
[fill]
symbol = " "
{{- end }}
