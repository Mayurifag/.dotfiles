{{- $ghostModel := includeTemplate "ai-model-opencode" (dict "model" .aiModels.fast) -}}
{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": { "name": "dracula", "mode": "dark" },
  "terminal": { "title": false },
  "session": { "sidebar": "auto" },
  "tabs": { "mode": "off" },
  "attention": { "notifications": false, "sound": false },
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "plugins": [
    "-opencode.sidebar.context",
    "-opencode.prompt.footer",
    "-makcimbx.opencode-pty",
    "./tui-plugins/context-warning",
    "./tui-plugins/codex-usage",
    "./tui-plugins/yakuake-status",
    "./tui-plugins/q-handoff",
    "opencode-prs@0.5.3",
    "opencode-quill@0.6.4",
    {
      "package": "opencode-ghost@1.3.15",
      "options": { "model": {{ $ghostModel | toJson }} }
    }
  ]
}
