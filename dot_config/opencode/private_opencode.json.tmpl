{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "think",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "update": "disable",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-6.1-terra-fast#max",
      "description": "Build (GPT 6.1 Terra Fast Max)"
    },
    "ultrathink": {
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "description": "Ultrathink (GPT 6 Astra)"
    },
    "think": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol#high",
      "description": "Think (GPT 6.1 Sol)"
    },
    "title": {
      "model": "openai/gpt-6-luna-fast#low"
    },
    "plan": {
      "disabled": true
    }
  },
  "plugins": [
    "@makcimbx/opencode-pty@0.6.1"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ (joinPath .chezmoi.sourceDir "keys.ejson" | ejsonDecrypt).context7_api_key }}"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
        "headers": {
          "x-api-key": "{{ (joinPath .chezmoi.sourceDir "keys.ejson" | ejsonDecrypt).exa_api_key }}"
        }
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx", ".css", ".html"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "dprint": {
      "command": ["dprint", "fmt", "--config", {{ joinPath .chezmoi.homeDir ".dprint.json" | toJson }}, "$FILE"],
      "extensions": [".json", ".jsonc", ".md", ".yaml", ".yml"]
    },
    "taplo": {
      "command": ["taplo", "format", "$FILE"],
      "extensions": [".toml"]
    }
  }
}
