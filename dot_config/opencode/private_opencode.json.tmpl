{{- $buildModel := includeTemplate "ai-model-opencode" (dict "model" .aiModels.usual "effort" .aiModels.usual.buildEffort) -}}
{{- $ultrathinkModel := includeTemplate "ai-model-opencode" (dict "model" .aiModels.ultrathink "effort" .aiModels.ultrathink.effort) -}}
{{- $thinkModel := includeTemplate "ai-model-opencode" (dict "model" .aiModels.smart "effort" .aiModels.smart.effort) -}}
{{- $lunaFastModel := includeTemplate "ai-model-opencode" (dict "model" .aiModels.fast "effort" .aiModels.fast.effort) -}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": {{ includeTemplate "ai-model-opencode" (dict "model" .aiModels.usual) | toJson }},
  "default_agent": "build",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "update": "disable",
  "agents": {
    "build": {
      "mode": "primary",
      "model": {{ $buildModel | toJson }},
      "description": {{ printf "Build (%s)" $buildModel | toJson }}
    },
    "ultrathink": {
      "mode": "primary",
      "model": {{ $ultrathinkModel | toJson }},
      "description": {{ printf "Ultrathink (%s)" $ultrathinkModel | toJson }}
    },
    "think": {
      "mode": "primary",
      "model": {{ $thinkModel | toJson }},
      "description": {{ printf "Think (%s)" $thinkModel | toJson }}
    },
    "luna": {
      "mode": "primary",
      "model": {{ $lunaFastModel | toJson }},
      "description": {{ printf "Luna Fast (%s)" $lunaFastModel | toJson }}
    },
    "title": {
      "model": {{ $lunaFastModel | toJson }}
    },
    "plan": {
      "disabled": true
    }
  },
  "plugins": [
    "@makcimbx/opencode-pty@0.6.1",
    {
      "package": "opencode-awake@0.1.0",
      "options": { "lid": true }
    },
    {
      "package": "opencode-auto-resume@1.2.2",
      "options": {
        "chunkTimeoutMs": 180000,
        "maxRetries": 3
      }
    }
  ],
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
        "headers": {
          "x-api-key": "{{ (joinPath .chezmoi.sourceDir "keys.ejson" | ejsonDecrypt).exa_api_key }}"
        }
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx", ".css", ".html"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "dprint": {
      "command": ["dprint", "fmt", "--config", {{ joinPath .chezmoi.homeDir ".dprint.json" | toJson }}, "$FILE"],
      "extensions": [".json", ".jsonc", ".md", ".yaml", ".yml"]
    },
    "taplo": {
      "command": ["taplo", "format", "$FILE"],
      "extensions": [".toml"]
    }
  }
}
