;; kanata.kbd — Linux key remapping
;; Managed by chezmoi — edit at ~/.local/share/chezmoi/dot_config/kanata/kanata.kbd
;;
;; Deploys to: ~/.config/kanata/kanata.kbd
;; Platform: Linux (systemd user service)
;;
;; RAlt typography layer: 18 Birman layout unicode mappings.
;; CapsLock passes through without remapping.

(defcfg
)

(defsrc
  caps  ralt  -  2  3  4  5  6  7  8  9  0  =  r  t  p  /  h  ,  .
)

(defalias
  emdash (unicode —)
  sq2    (unicode ²)
  sq3    (unicode ³)
  qtr    (unicode ¼)
  half   (unicode ½)
  tqtr   (unicode ¾)
  ique   (unicode ¿)
  inf    (unicode ∞)
  larr   (unicode ←)
  rarr   (unicode →)
  pm     (unicode ±)
  reg    (unicode ®)
  tm     (unicode ™)
  ost    (unicode Ø)
  elip   (unicode …)
  rub    (unicode ₽)
  laq    (unicode «)
  raq    (unicode »)
)

(deflayer default
  _  (layer-while-held typography)  _  _  _  _  _  _  _  _  _  _  _  _  _  _  _  _  _  _
)

(deflayer typography
  _  _  @emdash  @sq2  @sq3  @qtr  @half  @tqtr  @ique  @inf  @larr  @rarr  @pm  @reg  @tm  @ost  @elip  @rub  @laq  @raq
)
