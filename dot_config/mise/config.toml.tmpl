{{- /* chezmoi:template:left-delimiter=[% right-delimiter=%] */ -}}
[settings]
auto_install = true
not_found_auto_install = true
use_versions_host_track = false
trusted_config_paths = ["/"]
hook_env.cache_ttl = "10m"
# Virtual environments and Rustup overrides can use versions outside mise's tracking.
# Developer cleanup checks Node installations for global npm packages before pruning.
prune.exclude = ["node", "python", "rust"]

[% if eq .chezmoi.os "windows" -%]
[tool_alias]
eza = "cargo:eza"

[% end -%]
[tools]
node = "latest"
go = { version = "1.27.4", postinstall = { run = "go telemetry off", when = "always" } }
python = "3.15.2"
[% if eq .chezmoi.os "windows" -%]
ruby = "4.0.9"
[% else -%]
ruby = "truffleruby-40.0.0"
[% end -%]
usage = "7.4.1"
uv = "0.13.10"
bun = "1.4.5"
chezmoi = "2.74.2"
fzf = { version = "0", auto_update = "24h" }
lazygit = { version = "0", auto_update = "24h" }
starship = "1.27.0"
"npm:@opencode/cli" = { version = "latest", allow_builds = ["@opencode/cli"] }
"npm:@prantlf/jsonlint" = "17.0.1"
"npm:actions-up" = "2.1.0"
"npm:ctx7" = "0.13.0"
"npm:svelte-language-server" = { version = "0.18.6", trust_policy_excludes = ["svelte@4.2.20"] }
markdownlint-cli2 = "0.24.2"
prettier = { version = "3", auto_update = "24h" }
dust = { version = "1", auto_update = "24h" }
zoxide = "0.10.0"
tlrc = "1.13.1"
eza = "0.23.5"
ripgrep = { version = "16", auto_update = "24h" }
sd = "1.1.0"
dprint = { version = "0", auto_update = "24h" }
taplo = { version = "0", auto_update = "24h" }
lua-language-server = "3.19.2"
lazydocker = "0.25.2"
ejson = "1.6.0"
editorconfig-checker = "4.0.2"
glow = { version = "3", auto_update = "24h" }
golangci-lint = "2.15.0"
shfmt = { version = "3", auto_update = "24h" }
actionlint = "1.7.12"
yq = "4.54.3"
gallery-dl = "1.32.21"
ruff = { version = "0", auto_update = "24h" }
yamllint = "1.38.0"
"github:pamburus/hl" = { version = "0.36", auto_update = "24h" }
"github:Mayurifag/yawn" = "0.1.5"
"cargo:cargo-update" = "22.1.5"
"cargo:git-trim" = "0.4.4"
killport = "2.0.2"
llmfit = "1.1.21"
watchexec = "2.8.0"
[%- if eq .chezmoi.os "windows" %]
"github:vicinaehq/vicinae" = { version = "0.30.1", asset_pattern = "vicinae-x64-portable.zip" }
[%- end %]
[%- if eq .chezmoi.os "linux" %]
"github:Mayurifag/conditional-launcher" = "0.2.0"
[%- if eq .chezmoi.hostname "steamdeck" %]
gh = "2.105.0"
"github:opencloud-eu/desktop" = { version = "4.0.0", asset_pattern = "OpenCloud_Desktop-v*-linux-gcc-x86_64.AppImage", format = "raw", bin = "opencloud" }
[%- end %]
[%- end %]
rust = "1.100.0"

[% if eq .chezmoi.os "windows" -%]
[tools."github:Kjerne/KJ-BatteryHub"]
version = "1.3.1"
asset_pattern = "KJ-BatteryHub-*-portable.zip"
checksum = "sha256:8e0336ef123c4c742e430222a5175dc512fca0d05d094e38ffaf03f0355fe29f"

[% end -%]
[bootstrap.services.mise-tool-update]
builtin = "tool-update"
