{{- /* chezmoi:template:left-delimiter=[% right-delimiter=%] */ -}}
[settings]
auto_install = true
not_found_auto_install = true
use_versions_host_track = false
trusted_config_paths = ["/"]
hook_env.cache_ttl = "10m"

[% if eq .chezmoi.os "windows" -%]
[tool_alias]
eza = "cargo:eza"

[% end -%]
[tools]
node = "26.13.0"
go = { version = "1.27.3", postinstall = { run = "go telemetry off", when = "always" } }
python = "3.15.2"
[% if eq .chezmoi.os "windows" -%]
ruby = "4.0.9"
[% else -%]
ruby = "truffleruby-40.0.0"
[% end -%]
usage = "7.3.0"
uv = "0.13.7"
bun = "1.4.4"
chezmoi = "2.74.0"
fzf = { version = "0", auto_update = "24h" }
lazygit = { version = "0", auto_update = "24h" }
starship = "1.27.0"
"npm:@opencode/cli" = { version = "2.2.6", allow_builds = ["@opencode/cli"] }
"npm:@prantlf/jsonlint" = "17.0.1"
"npm:actions-up" = "1.14.1"
"npm:ctx7" = "0.10.0"
markdownlint-cli2 = "0.24.0"
prettier = { version = "3", auto_update = "24h" }
dust = { version = "1", auto_update = "24h" }
zoxide = "0.10.0"
tlrc = "1.13.1"
eza = "0.23.5"
ripgrep = { version = "15", auto_update = "24h" }
sd = "1.1.0"
dprint = { version = "0", auto_update = "24h" }
taplo = { version = "0", auto_update = "24h" }
lua-language-server = "3.19.2"
lazydocker = "0.25.2"
ejson = "1.6.0"
editorconfig-checker = "4.0.2"
glow = { version = "3", auto_update = "24h" }
golangci-lint = "2.15.0"
shfmt = { version = "3", auto_update = "24h" }
actionlint = "1.7.12"
yq = "4.54.2"
gallery-dl = "1.32.19"
ruff = { version = "0", auto_update = "24h" }
yamllint = "1.38.0"
"github:pamburus/hl" = { version = "0.36", auto_update = "24h" }
"github:Mayurifag/yawn" = "0.1.2"
"cargo:cargo-update" = "20.0.0"
"cargo:git-trim" = "0.4.4"
"cargo:killport" = "2.0.2"
"cargo:llmfit" = "0.9.23"
"cargo:watchexec-cli" = "2.8.0"
[%- if eq .chezmoi.os "windows" %]
"github:vicinaehq/vicinae" = { version = "0.30.0", asset_pattern = "vicinae-x64-portable.zip" }
[%- end %]
[%- if eq .chezmoi.os "linux" %]
"github:Mayurifag/conditional-launcher" = "0.1.8"
[%- end %]
rust = "1.99.1"

[bootstrap.services.mise-tool-update]
builtin = "tool-update"
