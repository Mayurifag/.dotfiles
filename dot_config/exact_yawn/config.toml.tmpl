main_provider = "opencode_cli"
fallback_provider = "gemini"
auto_push = true
auto_stage = true
squash_auto_push = true
wait_for_ssh_keys = true

[providers.opencode_cli]
model = {{ includeTemplate "ai-model-opencode" (dict "model" .aiModels.usual) | toJson }}

[providers.gemini]
api_key = "{{ (joinPath .chezmoi.sourceDir "keys.ejson" | ejsonDecrypt).gemini_api_key }}"
model = {{ .aiModels.geminiFallback.id | toJson }}
