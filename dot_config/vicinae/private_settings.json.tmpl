{
{{- if eq .chezmoi.os "windows" }}
  "$schema": "https://vicinae.com/schemas/config.json",
{{- end }}
  "telemetry": {
    "system_info": false
  },
{{- if eq .chezmoi.os "windows" }}
  "global_shortcuts": {
    "toggle": "super+space"
  },
{{- end }}
  "close_on_focus_loss": false,
  "pop_to_root_on_close": true,
  "escape_key_behavior": "close_window",
  "tray": {
    "enabled": false
  },
  "font": {
    "normal": {
      "family": "{{ if eq .chezmoi.os "linux" }}SF Pro Text{{ else }}auto{{ end }}"
    }
  },
  "theme": {
    "dark": {
      "name": "dracula",
      "icon_theme": "{{ if eq .chezmoi.os "linux" }}Papirus-Dark{{ else }}auto{{ end }}"
    }
  },
  "launcher_window": {
    "opacity": 0.96,
    "layer_shell": {
      "keyboard_interactivity": "on_demand"
    }
  },
  "providers": {
    "ai": {
      "preferences": {
        "providers": {
          "codex": {
            "type": "codex",
            "fields": {
{{- if eq .chezmoi.os "windows" }}
              "executable": {{ joinPath (env "LOCALAPPDATA") "mise" "shims" "codex.exe" | toJson }}
{{- end }}
            }
          }
        },
        "defaultModel": {{ printf "codex:%s" .aiModels.usual.id | toJson }}
      }{{ if ne .chezmoi.os "linux" }},
      "entrypoints": {
{{- if eq .chezmoi.os "windows" }}
        "chat": {"enabled": false},
{{- end }}
        "quick": {"shortcut": "alt+SPACE"}
      }{{ end }}
    },
    "applications": {
      "entrypoints": {
        "cachyos-hello": {"enabled": false},
        "com.ayugram": {"alias": "telegram"}
      }
    },
    "core": {
      "entrypoints": {
        "sponsor": {"enabled": false}
      }
    },
    "developer": {"enabled": false},
    "files": {
      "preferences": {
        "autoIndexing": true,
        "indexingPaths": {{ list .chezmoi.homeDir | toJson }},
        "excludedIndexingPaths": []
      }
    },
    "power": {
      "entrypoints": {
        "hibernate": {"enabled": false},
        "lock": {"enabled": true},
        "logout": {"enabled": false},
        "sleep": {"enabled": false},
        "soft-reboot": {"enabled": false},
        "suspend": {"enabled": false}
      }
    },
    "snippets": {
      "preferences": {
        "enabled": true,
        "undo": true,
        "layout": "",
        "prePasteDelay": "0",
        "keyDelay": "2"
      }
    },
    "theme": {"enabled": false},
    "wm": {"enabled": false}
  }
}
