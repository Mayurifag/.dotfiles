pkgname=vicinae-mise
pkgver=0.30.0
pkgrel=1
pkgdesc='Vicinae launcher using the mise-managed Node runtime'
arch=('x86_64')
url='https://github.com/vicinaehq/vicinae'
license=('GPL3')
# Node is supplied by mise; the user service puts mise shims on PATH.
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg' 'layer-shell-qt' 'libqalculate' 'qtkeychain-qt6' 'syntax-highlighting' 'libgomp' 'vulkan-icd-loader')
provides=('vicinae')
conflicts=('vicinae' 'vicinae-bin')
source=("vicinae-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/vicinae-linux-x86_64-v${pkgver}.tar.gz")
sha256sums=('1d891668ebd8b0e4411aa71c41afdb10312b02e86844211a54033e21b4d0bf88')

package() {
    install -d "$pkgdir/usr"
    cp -a "$srcdir/bin" "$srcdir/libexec" "$srcdir/share" "$pkgdir/usr/"
    install -Dm644 "$srcdir/lib/systemd/user/vicinae.service" "$pkgdir/usr/lib/systemd/user/vicinae.service"
}
