#!/usr/bin/env python3
"""Open the public NAS on the home LAN."""

import argparse
import os
import socket
import subprocess
import sys

LAN_NAME = "nas.test"
LAN_ADDRESS = "192.168.69.139"
WINDOWS_DRIVE = "N:"
WINDOWS_SHARE = f"\\\\{LAN_NAME}\\Public"
LEGACY_WINDOWS_SHARE = r"\\100.113.201.147\Public"


def local_available():
    try:
        with socket.create_connection((LAN_ADDRESS, 445), timeout=1):
            pass
        return {
            result[4][0]
            for result in socket.getaddrinfo(LAN_NAME, 445, type=socket.SOCK_STREAM)
        } == {LAN_ADDRESS}
    except OSError:
        return False


def windows_drive_state():
    import ctypes
    import winreg
    from ctypes import wintypes

    try:
        with winreg.OpenKey(
            winreg.HKEY_CURRENT_USER, rf"Network\{WINDOWS_DRIVE[0]}"
        ) as key:
            remembered = winreg.QueryValueEx(key, "RemotePath")[0]
    except FileNotFoundError:
        remembered = None

    get_connection = ctypes.windll.mpr.WNetGetConnectionW
    get_connection.argtypes = [
        wintypes.LPCWSTR,
        wintypes.LPWSTR,
        ctypes.POINTER(wintypes.DWORD),
    ]
    get_connection.restype = wintypes.DWORD
    remote = ctypes.create_unicode_buffer(2048)
    length = wintypes.DWORD(len(remote))
    result = get_connection(WINDOWS_DRIVE, remote, ctypes.byref(length))
    if result not in (0, 1201, 2250):
        raise OSError(result, ctypes.FormatError(result).strip())

    if remembered is not None:
        remembered = str(remembered).rstrip("\\").casefold()
        if result == 0 and remote.value.rstrip("\\").casefold() != remembered:
            return "occupied"
        if remembered == WINDOWS_SHARE.casefold():
            if result == 0:
                return "configured"
            if result == 1201:
                return "free"
        elif remembered == LEGACY_WINDOWS_SHARE.casefold():
            return "legacy"
        else:
            return "occupied"
    elif result in (0, 1201):
        return "occupied"

    get_drives = ctypes.windll.kernel32.GetLogicalDrives
    get_drives.restype = wintypes.DWORD
    drives = get_drives()
    if not drives:
        raise OSError("Could not inspect existing Windows drives")
    return "occupied" if drives & (1 << (ord(WINDOWS_DRIVE[0]) - ord("A"))) else "free"


def map_windows_drive():
    import ctypes
    from ctypes import wintypes

    class NetResource(ctypes.Structure):
        _fields_ = [
            ("scope", wintypes.DWORD),
            ("type", wintypes.DWORD),
            ("display_type", wintypes.DWORD),
            ("usage", wintypes.DWORD),
            ("local_name", wintypes.LPWSTR),
            ("remote_name", wintypes.LPWSTR),
            ("comment", wintypes.LPWSTR),
            ("provider", wintypes.LPWSTR),
        ]

    resource = NetResource()
    resource.type = 1  # RESOURCETYPE_DISK
    resource.local_name = WINDOWS_DRIVE
    resource.remote_name = WINDOWS_SHARE
    connect = ctypes.windll.mpr.WNetAddConnection2W
    connect.argtypes = [
        ctypes.POINTER(NetResource),
        wintypes.LPCWSTR,
        wintypes.LPCWSTR,
        wintypes.DWORD,
    ]
    connect.restype = wintypes.DWORD
    result = connect(ctypes.byref(resource), None, None, 1)  # CONNECT_UPDATE_PROFILE
    if result:
        raise OSError(result, ctypes.FormatError(result).strip())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--mount", action="store_true", help="map the Windows NAS drive"
    )
    args = parser.parse_args()

    if args.mount:
        if sys.platform != "win32":
            print("--mount is available only on Windows.", file=sys.stderr)
            return 2
        try:
            state = windows_drive_state()
        except OSError as error:
            print(f"Could not check {WINDOWS_DRIVE}: {error}", file=sys.stderr)
            return 1
        if state == "legacy":
            print(
                f"{WINDOWS_DRIVE} still uses the old NetBird NAS mapping; it was not changed.\n"
                f"Close files on {WINDOWS_DRIVE}, then run `net use {WINDOWS_DRIVE} /delete` "
                "and `nas --mount` in the same logon and elevation as Explorer.",
                file=sys.stderr,
            )
            return 1
        if state == "occupied":
            print(
                f"{WINDOWS_DRIVE} is already in use; it was not changed.",
                file=sys.stderr,
            )
            return 1

    if not local_available():
        print("NAS unavailable. Connect to the home LAN.", file=sys.stderr)
        return 1

    if args.mount:
        try:
            if state != "configured":
                map_windows_drive()
                if windows_drive_state() != "configured":
                    raise OSError(
                        f"{WINDOWS_DRIVE} is not connected in this logon session"
                    )
            os.stat(f"{WINDOWS_DRIVE}\\")
        except OSError as error:
            print(f"Could not map {WINDOWS_DRIVE}: {error}", file=sys.stderr)
            print("Check the saved Windows credentials for the NAS.", file=sys.stderr)
            return 1
        print(f"NAS {WINDOWS_DRIVE} is connected to the home LAN.")
        return 0

    print("Opening the public NAS over the home LAN.", flush=True)
    try:
        if sys.platform == "win32":
            os.startfile(WINDOWS_SHARE)
        elif sys.platform == "darwin":
            subprocess.run(["open", f"smb://{LAN_NAME}/Public"], check=True)
        else:
            subprocess.run(["xdg-open", f"smb://{LAN_NAME}/Public"], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Could not open the NAS: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
