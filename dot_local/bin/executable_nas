#!/usr/bin/env python3
"""Open the public NAS using the home LAN or the authenticated NetBird tunnel."""

import argparse
import json
import os
import socket
import subprocess
import sys

LAN_NAME = "nas.test"
LAN_ADDRESS = "192.168.69.139"
VPN_ADDRESS = "100.113.201.147"
WINDOWS_DRIVE = "N:"


def reachable(address, timeout):
    try:
        with socket.create_connection((address, 445), timeout=timeout):
            return True
    except OSError:
        return False


def local_available():
    if not reachable(LAN_ADDRESS, 1):
        return False
    try:
        addresses = {
            result[4][0]
            for result in socket.getaddrinfo(LAN_NAME, 445, type=socket.SOCK_STREAM)
        }
    except OSError:
        return False
    return addresses == {LAN_ADDRESS}


def vpn_available():
    try:
        result = subprocess.run(
            ["netbird", "status", "--json"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )
        status = json.loads(result.stdout)
        peers = status.get("peers", {}).get("details", []) or []
        known_peer = any(
            peer.get("netbirdIp", "").split("/")[0] == VPN_ADDRESS for peer in peers
        )
        local_address = status.get("netbirdIp", "").split("/")[0]
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as route:
            route.connect((VPN_ADDRESS, 445))
            routed_over_netbird = route.getsockname()[0] == local_address
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError, TypeError):
        return False
    return (
        bool(local_address)
        and known_peer
        and routed_over_netbird
        and reachable(VPN_ADDRESS, 8)
    )


def choose_host(local_only, vpn_only, prefer_vpn=False):
    if local_only:
        choices = [(local_available, LAN_NAME, "home LAN")]
    elif vpn_only:
        choices = [(vpn_available, VPN_ADDRESS, "NetBird")]
    elif prefer_vpn:
        choices = [
            (vpn_available, VPN_ADDRESS, "NetBird"),
            (local_available, LAN_NAME, "home LAN"),
        ]
    else:
        choices = [
            (local_available, LAN_NAME, "home LAN"),
            (vpn_available, VPN_ADDRESS, "NetBird"),
        ]
    for available, host, connection in choices:
        if available():
            return host, connection
    return None


def windows_drive_state():
    import ctypes
    import winreg
    from ctypes import wintypes

    if ctypes.windll.shell32.IsUserAnAdmin():
        return "elevated"

    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Network\N") as key:
            remote = winreg.QueryValueEx(key, "RemotePath")[0]
    except FileNotFoundError:
        remote = None

    if remote is not None:
        known = {f"\\\\{host}\\Public".casefold() for host in (LAN_NAME, VPN_ADDRESS)}
        return (
            "configured" if str(remote).rstrip("\\").casefold() in known else "occupied"
        )

    get_drives = ctypes.windll.kernel32.GetLogicalDrives
    get_drives.restype = wintypes.DWORD
    drives = get_drives()
    if not drives:
        raise OSError("Could not inspect existing Windows drives")
    return "occupied" if drives & (1 << (ord("N") - ord("A"))) else "free"


def map_windows_drive(host):
    import ctypes
    from ctypes import wintypes

    class NetResource(ctypes.Structure):
        _fields_ = [
            ("scope", wintypes.DWORD),
            ("type", wintypes.DWORD),
            ("display_type", wintypes.DWORD),
            ("usage", wintypes.DWORD),
            ("local_name", wintypes.LPWSTR),
            ("remote_name", wintypes.LPWSTR),
            ("comment", wintypes.LPWSTR),
            ("provider", wintypes.LPWSTR),
        ]

    resource = NetResource()
    resource.type = 1  # RESOURCETYPE_DISK
    resource.local_name = WINDOWS_DRIVE
    resource.remote_name = f"\\\\{host}\\Public"
    connect = ctypes.windll.mpr.WNetAddConnection2W
    connect.argtypes = [
        ctypes.POINTER(NetResource),
        wintypes.LPCWSTR,
        wintypes.LPCWSTR,
        wintypes.DWORD,
    ]
    connect.restype = wintypes.DWORD
    result = connect(ctypes.byref(resource), "", "guest", 1)  # CONNECT_UPDATE_PROFILE
    if result:
        raise OSError(result, ctypes.FormatError(result).strip())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--local", action="store_true", help="use the home LAN only")
    mode.add_argument("--vpn", action="store_true", help="use NetBird only")
    parser.add_argument(
        "--mount", action="store_true", help="map the Windows NAS drive"
    )
    args = parser.parse_args()

    if args.mount:
        if sys.platform != "win32":
            print("--mount is available only on Windows.", file=sys.stderr)
            return 2
        try:
            state = windows_drive_state()
        except OSError as error:
            print(f"Could not check {WINDOWS_DRIVE}: {error}", file=sys.stderr)
            return 1
        if state == "configured":
            print(
                f"NAS {WINDOWS_DRIVE} is already configured; Windows will reconnect it when available."
            )
            return 0
        if state == "occupied":
            print(
                f"{WINDOWS_DRIVE} is already in use; it was not changed.",
                file=sys.stderr,
            )
            return 1
        if state == "elevated":
            print(
                "Run czapply or nas --mount from a non-administrator PowerShell window so Explorer can see the drive.",
                file=sys.stderr,
            )
            return 1

    selected = choose_host(args.local, args.vpn, prefer_vpn=args.mount)
    if selected is None:
        print(
            "NAS unavailable. Connect to the home LAN or start NetBird.",
            file=sys.stderr,
        )
        return 1
    host, connection = selected

    if args.mount:
        try:
            map_windows_drive(host)
        except OSError as error:
            print(f"Could not map {WINDOWS_DRIVE}: {error}", file=sys.stderr)
            print(
                "Windows may block guest SMB under its existing security policy; no settings were changed.",
                file=sys.stderr,
            )
            return 1
        print(
            f"NAS {WINDOWS_DRIVE} mapped over {connection}; Windows will reconnect it at sign-in."
        )
        return 0

    print(f"Opening the public NAS over {connection}.", flush=True)
    try:
        if sys.platform == "win32":
            os.startfile(f"\\\\{host}\\Public")
        elif sys.platform == "darwin":
            subprocess.run(["open", f"smb://{host}/Public"], check=True)
        else:
            subprocess.run(["xdg-open", f"smb://{host}/Public"], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Could not open the NAS: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
