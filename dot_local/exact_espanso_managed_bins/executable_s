#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys

DEFAULT_MODE = "live"
MODES = {
    "balanced": {
        "streamlink": [],
        "mpv": [
            "--demuxer-max-bytes=256MiB",
            "--demuxer-readahead-secs=60",
        ],
    },
    "live": {
        "streamlink": [
            "--twitch-low-latency",
            "--hls-live-edge",
            "2",
            "--hls-segment-stream-data",
        ],
        "mpv": ["--profile=low-latency"],
    },
    "buffer": {
        "streamlink": ["--retry-streams", "5", "--retry-max", "20"],
        "mpv": [
            "--demuxer-max-bytes=512MiB",
            "--demuxer-readahead-secs=180",
        ],
    },
}
BASE_STREAMLINK_ARGS = ["--retry-open", "3", "--title", "{author} - {title}"]
BASE_MPV_ARGS = [
    "--no-terminal",
    "--really-quiet",
    "--keep-open=no",
    "--loop-playlist=inf",
    "--loop-file=inf",
    "--no-resume-playback",
    "--force-window=immediate",
    "--cache=yes",
    "--demuxer-max-back-bytes=1800M",
    "--force-seekable=yes",
    "--hr-seek=yes",
    "--hr-seek-framedrop=yes",
]
USAGE = "Usage: s <url> [balanced|live|buffer] [audio]"


def find_mpv():
    player = shutil.which("mpv")
    if player:
        return player
    if sys.platform == "win32" and (program_files := os.environ.get("ProgramFiles")):
        player = os.path.join(program_files, "MPV Player", "mpv.exe")
        if os.path.isfile(player):
            return player
    return None


def popen_kwargs():
    kwargs = {
        "stdin": subprocess.DEVNULL,
        "stdout": subprocess.DEVNULL,
        "stderr": subprocess.DEVNULL,
    }
    if sys.platform == "win32":
        kwargs["creationflags"] = (
            subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP
        )
    else:
        kwargs["start_new_session"] = True
    return kwargs


def stream_url(value):
    if "://" in value:
        return value
    if "." in value:
        return f"https://{value}"
    return f"https://www.twitch.tv/{value}"


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 1
    if argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    audio_only = len(argv) > 1 and argv[-1] == "audio"
    mode_args = argv[1:-1] if audio_only else argv[1:]
    if len(mode_args) > 1:
        print(USAGE, file=sys.stderr)
        return 1

    url = stream_url(argv[0])
    options = MODES.get(mode_args[0] if mode_args else DEFAULT_MODE)
    if options is None:
        print(USAGE, file=sys.stderr)
        return 1

    player = find_mpv()
    if not player:
        print("s: mpv not found; install it or add it to PATH", file=sys.stderr)
        return 1

    args = [
        "streamlink",
        *BASE_STREAMLINK_ARGS,
        "--player",
        player,
        *options["streamlink"],
        "--player-args",
        " ".join([*BASE_MPV_ARGS, *options["mpv"], "{playerinput}"]),
        url,
        "audio_only,audio" if audio_only else "best",
    ]
    try:
        subprocess.Popen(args, **popen_kwargs())
    except FileNotFoundError:
        print("s: streamlink not found", file=sys.stderr)
        return 1
    return 0


raise SystemExit(main(sys.argv[1:]))
