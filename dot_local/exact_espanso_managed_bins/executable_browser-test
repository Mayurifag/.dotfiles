function dedicatedBrowserPids(profile) {
  const windows = process.platform === "win32";
  const paths = windows ? path.win32 : path;
  const normalize = (value) => windows ? paths.resolve(value).toLowerCase() : paths.resolve(value);
  const resolvedProfile = normalize(profile);
  return processRows().filter(([pid, command, actualExecutable]) => {
    if (pid === process.pid) return false;
    if (process.platform === "darwin") {
      if (typeof command !== "string" || !actualExecutable) throw new Error("Cannot establish native profile ownership");
      command = [actualExecutable, `--user-data-dir=${command}`];
    }
    const structured = Array.isArray(command);
    if (!structured && !windows) throw new Error("Cannot establish process ownership without structured argv");
    const executable = structured ? actualExecutable : command.match(/^("[^"]+"|'[^']+'|[^\s]+)(?=\s|$)/)?.[0];
    if (!executable) return false;
    const unquote = (value) => value.replace(/"([^"]*)"|'([^']*)'/g, (_, double, single) => double ?? single);
    const identity = structured ? executable : unquote(executable);
    const name = paths.basename(identity);
    if (!(windows ? /^chrome\.exe$/i : /^(chrome|google-chrome(?:-stable)?|Google Chrome)$/).test(name) &&
        !(process.env.OPENCODE_CHROME_PATH && normalize(identity) === normalize(expandHome(process.env.OPENCODE_CHROME_PATH)))) return false;
    const remainder = structured ? null : command.slice(executable.length);
    const args = structured ? command.slice(1) : (remainder.match(/(?:[^\s"']+|"[^"]*"|'[^']*')+/g) || []).map(unquote);
    const profiles = args.flatMap((arg, index) => arg === "--user-data-dir" ? [args[index + 1] || ""] : arg.startsWith("--user-data-dir=") ? [arg.slice(16)] : []);
    return profiles.length === 1 && paths.isAbsolute(profiles[0]) && normalize(profiles[0]) === resolvedProfile;
  }).map(([pid]) => pid);
}

async function terminateProfile(profile, number) {
  validateProfilePath(profile, process.env.OPENCODE_BROWSER_TEST_ALLOW_TEMPLATE_PROFILE === "1");
  let pids = dedicatedBrowserPids(profile, number);
  if (!pids.length) return waitForBrowserExit(profile, number);
  if (process.platform === "win32") {
    for (const pid of pids) child.spawnSync("taskkill", ["/PID", String(pid), "/T"], { stdio: "ignore" });
    await sleep(800);
    for (const pid of dedicatedBrowserPids(profile, number)) child.spawnSync("taskkill", ["/PID", String(pid), "/T", "/F"], { stdio: "ignore" });
    await waitForBrowserExit(profile, number);
    return;
  }
  for (const pid of pids) {
    try {
      process.kill(pid, "SIGTERM");
    } catch {}
  }
  const deadline = Date.now() + 2000;
  while (Date.now() < deadline && (dedicatedBrowserPids(profile, number).length || (number != null && !(await portFree(number))))) await sleep(100);
  for (const pid of dedicatedBrowserPids(profile, number)) {
    try {
      process.kill(pid, "SIGKILL");
    } catch {}
  }
  await waitForBrowserExit(profile, number);
}

async function waitForBrowserExit(profile, number) {
  const deadline = Date.now() + 5000;
  while (Date.now() < deadline) {
    if (!dedicatedBrowserPids(profile, number).length && (number == null || (await portFree(number)))) {
      const lock = path.join(profile, "SingletonLock");
      try {
        fs.lstatSync(lock); // existsSync misses Chrome's dangling lock symlink.
      } catch (error) {
        if (error.code === "ENOENT") return;
        throw new Error(`Cannot establish profile lock state: ${error.message}`);
      }
      throw new Error(`Cannot confirm Chrome closed: profile lock exists: ${lock}. Verify Chrome has exited before removing a stale lock.`);
    }
    await sleep(100);
  }
  const pids = dedicatedBrowserPids(profile, number);
  const portBusy = number != null && !(await portFree(number));
  throw new Error(`Chrome did not fully close${pids.length ? `; remaining pids: ${pids.join(",")}` : ""}${portBusy ? `; port still busy: ${HOST}:${number}` : ""}`);
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return null;
  }
}

function writeJson(file, data) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(data));
  fs.renameSync(tmp, file);
}

function preferencesPath(profile) {
  return path.join(profile, "Default", "Preferences");
}

function preferences(profile) {
  return readJson(preferencesPath(profile)) || {};
}

function ensureLoopback(profile) {
  const file = preferencesPath(profile);
  const data = readJson(file);
  if (data === null && fs.existsSync(file)) throw new Error(`Chrome Preferences is not valid JSON: ${file}`);
  const prefs = data || {};
  prefs.profile ||= {};
  prefs.profile.default_content_setting_values ||= {};
  prefs.profile.default_content_setting_values.loopback_network = 1;
  writeJson(file, prefs);
}

async function resetProfile(profile, number) {
  validateProfilePath(profile);
  const template = path.resolve(TEMPLATE_PROFILE);
  if (!fs.existsSync(template)) throw new Error(`browser profile template missing: ${template}. Regenerate it from ${path.join(path.dirname(template), "GENERATE.md")}`);
  if (path.resolve(profile) === template) throw new Error("refusing to launch with the template profile directly");
  await terminateProfile(profile, number);
  validateProfilePath(profile); // Ancestors may have changed while waiting for Chrome to exit.
  fs.rmSync(profile, { recursive: true, force: true });
  fs.mkdirSync(path.dirname(profile), { recursive: true });
  fs.cpSync(template, profile, { recursive: true, verbatimSymlinks: true });
  ensureLoopback(profile);
}

function extensionManifest(profile, id) {
  const root = path.join(profile, "Default", "Extensions", id);
  if (!fs.existsSync(root)) return null;
  const versions = fs.readdirSync(root).sort().reverse();
  for (const version of versions) {
    const manifest = readJson(path.join(root, version, "manifest.json"));
    if (manifest) return manifest;
  }
  return null;
}

function extensionInstalled(profile, ids) {
  return ids.some((id) => extensionManifest(profile, id));
}

function tampermonkeyId(profile) {
  const id = TM_IDS.find((candidate) => extensionManifest(profile, candidate));
  if (!id) throw new Error("Tampermonkey is not installed in the browser-mcp template profile");
  return id;
}

function storageScripts(profile, ids) {
  const roots = ids.flatMap((id) => [
    path.join(profile, "Default", "Local Extension Settings", id),
    path.join(profile, "Default", "IndexedDB", `chrome-extension_${id}_0.indexeddb.leveldb`),
    path.join(profile, "Default", "Extension State"),
  ]);
  const scripts = new Map();
  for (const root of roots) scanStorage(root, scripts);
  return [...scripts.values()].sort((a, b) => a.name.localeCompare(b.name));
}

function scanStorage(file, scripts) {
  if (!fs.existsSync(file)) return;
  let stat;
  try {
    stat = fs.statSync(file);
  } catch {
    return;
  }
  if (stat.isDirectory()) {
    let entries;
    try {
      entries = fs.readdirSync(file);
    } catch {
      return;
    }
    for (const entry of entries) scanStorage(path.join(file, entry), scripts);
    return;
  }
  if (!stat.isFile() || stat.size > 20 * 1024 * 1024) return;
  let text;
  try {
    text = fs.readFileSync(file, "utf8");
  } catch {
    return;
  }
  const blocks = [...text.matchAll(USER_BLOCK_RE)].map((match) => match.groups.body);
  for (const block of blocks.length ? blocks : [text]) {
    const name = block.match(NAME_RE)?.[1]?.trim().replace(/^"|"$/g, "");
    if (!name || name.startsWith("__MSG_")) continue;
    const version = block.match(VERSION_RE)?.[1]?.trim().replace(/^"|"$/g, "") || null;
    scripts.set(name, { name, version });
  }
}

async function cdp(wsUrl) {
  const ws = new WebSocket(wsUrl);
  try {
    await new Promise((resolve, reject) => {
      const timer = setTimeout(() => finish(new Error(`WebSocket connection timed out: ${wsUrl}`)), 3000);
      const finish = (error) => {
        clearTimeout(timer);
        ws.onopen = ws.onerror = ws.onclose = null;
        if (error) reject(error);
        else resolve();
      };
      ws.onopen = () => finish();
      ws.onerror = () => finish(new Error(`WebSocket connection failed: ${wsUrl}`));
      ws.onclose = () => finish(new Error(`WebSocket closed: ${wsUrl}`));
    });
  } catch (error) {
    ws.close();
    throw error;
  }
  let id = 0;
  const pending = new Map();
  const listeners = new Set();
  const failPending = () => {
    for (const request of pending.values()) request.finish(new Error("WebSocket closed"));
  };
  ws.addEventListener("close", failPending);
  ws.addEventListener("error", failPending);
  ws.addEventListener("message", (event) => {
    let data;
    try { data = JSON.parse(event.data); } catch { return; }
    if (data.id) {
      const request = pending.get(data.id);
      if (request) request.finish(data.error ? new Error(`${request.method}: ${JSON.stringify(data.error)}`) : null, data.result || {});
    } else {
      if (data.method === "Page.javascriptDialogOpening") {
        send("Page.handleJavaScriptDialog", { accept: true }).catch(() => {});
      }
      for (const listener of listeners) listener(data);
    }
  });
  const send = (method, params = {}, timeout = 5000) => new Promise((resolve, reject) => {
    const msg = ++id;
    const finish = (error, result) => {
      clearTimeout(timer);
      pending.delete(msg);
      if (error) reject(error);
      else resolve(result);
    };
    const timer = setTimeout(() => finish(new Error(`${method} timed out`)), timeout);
    pending.set(msg, { method, finish });
    try { ws.send(JSON.stringify({ id: msg, method, params })); } catch (error) { finish(error); }
  });
  return { ws, send, subscribe(listener) { listeners.add(listener); return () => listeners.delete(listener); } };
}

async function browserWs(number) {
  return (await getJson(`${browserUrl(number)}/json/version`)).webSocketDebuggerUrl;
}

async function createTarget(number, url) {
  const client = await cdp(await browserWs(number));
  try {
    return (await client.send("Target.createTarget", { url, background: false })).targetId;
  } finally {
    client.ws.close();
  }
}

async function closeTargets(number, ids) {
  const unique = [...new Set(ids.filter(Boolean))];
  if (!unique.length) return;
  const client = await cdp(await browserWs(number)).catch(() => null);
  if (!client) return;
  try {
    for (const targetId of unique) await client.send("Target.closeTarget", { targetId }).catch(() => {});
  } finally {
    client.ws.close();
  }
}

async function targetByPrefix(number, prefix, timeout = 5000) {
  const deadline = Date.now() + timeout;
  while (Date.now() < deadline) {
    const found = (await targets(number)).find((target) => target.type === "page" && target.url?.startsWith(prefix) && target.webSocketDebuggerUrl);
    if (found) return found;
    await sleep(100);
  }
  throw new Error(`DevTools target not found: ${prefix}`);
}

async function evaluate(target, expression, timeout = 5000) {
  const client = await cdp(target.webSocketDebuggerUrl);
  try {
    if (target.type === "page") await client.send("Page.enable", {}, timeout);
    return await evaluateClient(client, expression, timeout);
  } finally {
    client.ws.close();
  }
}

async function evaluateClient(client, expression, timeout = 5000) {
  const result = await client.send("Runtime.evaluate", { expression, returnByValue: true, awaitPromise: true }, timeout);
  if (result.exceptionDetails) throw new Error(result.exceptionDetails.exception?.description || result.exceptionDetails.text || "JavaScript evaluation failed");
  return Object.prototype.hasOwnProperty.call(result.result || {}, "value") ? result.result.value : result.result?.description;
}

async function inspect(client, seconds, options = {}) {
  const output = { console: [], errors: [], failedNetwork: [] };
  const requests = new Map();
  const unsubscribe = client.subscribe(({ method, params = {} }) => {
    if (method === "Runtime.consoleAPICalled") {
      output.console.push(params);
      if (params.type === "error") output.errors.push(params);
    }
    else if (method === "Runtime.exceptionThrown") output.errors.push(params);
    else if (method === "Log.entryAdded") {
      output.console.push(params.entry);
      if (params.entry?.level === "error") output.errors.push(params.entry);
    } else if (method === "Network.requestWillBeSent") requests.set(params.requestId, params.request?.url);
    else if (method === "Network.responseReceived" && params.response?.status >= 400) {
      output.failedNetwork.push({ requestId: params.requestId, url: params.response.url, status: params.response.status });
    } else if (method === "Network.loadingFailed") {
      output.failedNetwork.push({ ...params, url: requests.get(params.requestId) || null });
      requests.delete(params.requestId);
    } else if (method === "Network.loadingFinished") requests.delete(params.requestId);
  });
  try {
    await client.send("Runtime.enable");
    await client.send("Log.enable");
    await client.send("Network.enable");
    if (options.navigate || options.reload) await client.send("Page.enable");
    if (options.navigate) {
      const result = await client.send("Page.navigate", { url: options.navigate });
      if (result.errorText) throw new Error(result.errorText);
    }
    if (options.reload) await client.send("Page.reload", { ignoreCache: true });
    await new Promise((resolve, reject) => {
      const finish = (error) => {
        clearTimeout(timer);
        client.ws.removeEventListener("close", disconnected);
        client.ws.removeEventListener("error", disconnected);
        if (error) reject(error);
        else resolve();
      };
      const disconnected = () => finish(new Error("WebSocket closed during inspection"));
      const timer = setTimeout(() => finish(), seconds * 1000);
      client.ws.addEventListener("close", disconnected);
      client.ws.addEventListener("error", disconnected);
      if (client.ws.readyState !== 1) disconnected();
    });
    return output;
  } finally {
    unsubscribe();
  }
}

async function reloadUserscriptPages(number, rules) {
  const reloaded = [];
  for (const target of await targets(number)) {
    if (target.type !== "page" || !target.webSocketDebuggerUrl || !pageMatchesRules(target.url, rules)) continue;
    const client = await cdp(target.webSocketDebuggerUrl).catch(() => null);
    if (!client) continue;
    try {
      await client.send("Page.reload", { ignoreCache: true }, 5000);
      reloaded.push(target.url);
    } finally {
      client.ws.close();
    }
  }
  return reloaded;
}

async function requireDevtools(number) {
  if (!(await devtoolsAvailable(number))) throw new Error(`Chrome DevTools is not available at ${browserUrl(number)}. Run browser-test --launch <url> first.`);
}

async function installTampermonkey(profile, number, url) {
  await requireDevtools(number);
  const id = tampermonkeyId(profile);
  const rules = await getText(url).then(userscriptUrlRules).catch(() => ({ include: [], exclude: [] }));
  let target = null;
  const deadline = Date.now() + 10000;
  const createdTarget = await createTarget(number, url);
  try {
    while (Date.now() < deadline && !target) {
      try {
        target = await targetByPrefix(number, `chrome-extension://${id}/ask.html`, 2000);
      } catch {
        await sleep(500);
      }
    }
    if (!target) throw new Error(`DevTools target not found: chrome-extension://${id}/ask.html`);
    const expression = `(() => {
      const button = Array.from(document.querySelectorAll("input[type=button],button"))
        .find((el) => /^(Install|Update|Reinstall)$/i.test((el.value || el.innerText || "").trim()));
      if (!button) return { installed: false, text: document.body.innerText.slice(0, 500) };
      button.click();
      return { installed: true };
    })()`;
    let result = null;
    for (let i = 0; i < 25; i++) {
      result = await evaluate(target, expression, 5000);
      if (result?.installed) break;
      await sleep(200);
    }
    if (result?.installed) result.reloadedPages = await reloadUserscriptPages(number, rules);
    return result;
  } finally {
    await closeTargets(number, [createdTarget, target?.id]);
  }
}

async function deleteTampermonkey(profile, number, name) {
  await requireDevtools(number);
  const id = tampermonkeyId(profile);
  const createdTarget = await createTarget(number, `chrome-extension://${id}/options.html#nav=dashboard`);
  let target = null;
  try {
    target = await targetByPrefix(number, `chrome-extension://${id}/options.html`, 5000);
    const expression = `(() => {
      const wanted = ${JSON.stringify(name)};
      window.confirm = () => true;
      const text = (el) => (el.innerText || el.value || el.title || el.getAttribute("aria-label") || "").trim();
      const row = Array.from(document.querySelectorAll("tr.scripttr,tr,.script,.script-row"))
        .find((el) => (el.querySelector("td.script_name span")?.innerText || text(el)).trim() === wanted);
      if (!row) return { deleted: false, reason: "script not found", scripts: Array.from(document.querySelectorAll("tr.scripttr")).map(text).filter(Boolean) };
      const control = Array.from(row.querySelectorAll("button,input,i,a,span"))
        .find((el) => /delete|trash|remove/i.test(text(el)) || /delete|trash|remove/i.test(el.className || ""));
      if (!control) return { deleted: false, reason: "delete control not found", text: text(row).slice(0, 500) };
      control.click();
      return { deleted: true, name: wanted };
    })()`;
    let result = null;
    for (let i = 0; i < 25; i++) {
      result = await evaluate(target, expression, 5000);
      if (result?.deleted) break;
      await sleep(200);
    }
    if (!result?.deleted) return result;
    result.trash = await emptyTampermonkeyTrash(number, id);
    return result;
  } finally {
    await closeTargets(number, [createdTarget, target?.id]);
  }
}

async function emptyTampermonkeyTrash(number, id) {
  const createdTarget = await createTarget(number, `chrome-extension://${id}/options.html#nav=trash`);
  let target = null;
  try {
    target = await targetByPrefix(number, `chrome-extension://${id}/options.html`, 5000);
    const expression = `(() => {
      window.confirm = () => true;
      const text = (el) => (el.innerText || el.value || el.title || el.getAttribute("aria-label") || "").trim();
      const button = Array.from(document.querySelectorAll("button,input,i,a,span"))
        .find((el) => /^Delete all$/i.test(text(el)) || /delete_all|delall/i.test(el.id || ""));
      if (!button) return { emptied: false, reason: "delete all control not found", text: document.body.innerText.slice(0, 500) };
      button.click();
      return { emptied: true };
    })()`;
    let result = null;
    for (let i = 0; i < 25; i++) {
      result = await evaluate(target, expression, 5000);
      if (result?.emptied) return result;
      await sleep(200);
    }
    return result;
  } finally {
    await closeTargets(number, [createdTarget, target?.id]);
  }
}

async function dashboardScripts(profile, number) {
  if (!(await devtoolsAvailable(number))) return null;
  let createdTarget = null;
  let target = null;
  try {
    const id = tampermonkeyId(profile);
    createdTarget = await createTarget(number, `chrome-extension://${id}/options.html#nav=dashboard`);
    target = await targetByPrefix(number, `chrome-extension://${id}/options.html`, 5000);
    for (let i = 0; i < 20; i++) {
      const scripts = await evaluate(target, `(() => Array.from(document.querySelectorAll("tr.scripttr")).map((row) => {
        if (!row.id || row.id.includes("filler")) return null;
        const name = (row.querySelector("td.script_name span")?.innerText || "").trim();
        if (!name || name === "<New userscript>") return null;
        const cells = Array.from(row.querySelectorAll("td")).map((cell) => cell.innerText.trim()).filter(Boolean);
        const version = cells.find((cell) => /^\\d+(?:\\.\\d+)+(?:[-+][\\w.-]+)?$/.test(cell)) || null;
        return { name, version };
      }).filter(Boolean))()`, 5000);
      if (Array.isArray(scripts) && scripts.length) return scripts.sort((a, b) => a.name.localeCompare(b.name));
      await sleep(200);
    }
    return [];
  } catch {
  } finally {
    await closeTargets(number, [createdTarget, target?.id]);
  }
  return null;
}

async function localViteDiagnostics(number) {
  if (!(await devtoolsAvailable(number))) return [];
  const out = [];
  for (const target of await targets(number)) {
    if (target.type !== "page" || !target.url?.startsWith("https://") || !target.webSocketDebuggerUrl) continue;
    const resources = await evaluate(target, `(() => performance.getEntriesByType('resource').map((entry) => ({ url: entry.name, responseStatus: entry.responseStatus || 0 })))()`, 5000).catch(() => []);
    if (!Array.isArray(resources)) continue;
    const urls = resources.filter((entry) => LOCAL_VITE_RE.test(entry.url)).map((entry) => entry.url);
    if (urls.length) out.push({ pageUrl: target.url, localViteUserscriptUrls: urls, failedLocalViteUserscriptRequests: resources.filter((entry) => LOCAL_VITE_RE.test(entry.url) && ![200, 304].includes(entry.responseStatus)) });
  }
  return out;
}

async function status(chrome, profile, number) {
  const prefs = preferences(profile);
  const setting = prefs.profile?.default_content_setting_values?.loopback_network;
  const scripts = await dashboardScripts(profile, number);
  return {
    chrome,
    profile,
    port: number,
    browserUrl: browserUrl(number),
    profileExists: fs.existsSync(profile),
    devtoolsAvailable: await devtoolsAvailable(number),
    portFree: await portFree(number),
    tampermonkeyInstalled: extensionInstalled(profile, TM_IDS),
    stylusInstalled: extensionInstalled(profile, STYLUS_IDS),
    scripts: scripts ?? storageScripts(profile, TM_IDS),
    styles: storageScripts(profile, STYLUS_IDS),
    loopbackNetworkPermissions: { default: setting == null ? null : { setting, label: SETTING_LABELS[setting] || String(setting) } },
    localViteUserscriptDiagnostics: await localViteDiagnostics(number),
  };
}

async function launchBrowser(chrome, profile, number, url) {
  await terminateProfile(profile, number);
  if (!(await portFree(number))) throw new Error(`Port ${HOST}:${number} is already in use. Run browser-test --close or set OPENCODE_BROWSER_TEST_PORT to a free port.`);
  if (path.resolve(profile) === path.resolve(TEMPLATE_PROFILE) && process.env.OPENCODE_BROWSER_TEST_ALLOW_TEMPLATE_PROFILE === "1") {
    validateProfilePath(profile, true);
    fs.mkdirSync(profile, { recursive: true });
    ensureLoopback(profile);
  } else {
    await resetProfile(profile, number);
  }
  const args = [
    `--remote-debugging-address=${HOST}`,
    `--remote-debugging-port=${number}`,
    `--user-data-dir=${profile}`,
    "--no-first-run",
    "--no-default-browser-check",
    "--disable-session-crashed-bubble",
    "--window-size=1280,900",
    "--new-window",
    url,
  ];
  if (process.platform === "darwin" && !process.env.OPENCODE_CHROME_PATH) child.spawn("open", ["-g", "-n", "-a", "Google Chrome", "--args", ...args], { detached: true, stdio: "ignore" }).unref();
  else child.spawn(chrome, args, { detached: true, stdio: "ignore" }).unref();
  const deadline = Date.now() + START_TIMEOUT;
  while (Date.now() < deadline) {
    if (await devtoolsAvailable(number)) return;
    await sleep(200);
  }
  await terminateProfile(profile, number);
  throw new Error(`Chrome did not expose DevTools at ${browserUrl(number)} within ${START_TIMEOUT / 1000}s`);
}

const HELP = `Usage:
  browser-test --help
  browser-test --launch <url>
  browser-test --status | --check | --close | --pages
  browser-test --tampermonkey-install <url>
  browser-test --tampermonkey-delete <name>
  browser-test --target <exact-id> [--navigate <url>] [--eval <JS-expression>]
               [--screenshot <path>] [--inspect <seconds> [--reload]]

Target actions may be combined. Inspection runs first (including navigation/reload),
then evaluation and PNG screenshot. Navigation alone is allowed. No targets open implicitly.
Navigation does not wait for page load; combine --navigate with --inspect for a capture window.
--pages lists all inspectable targets, including extensions and service workers.
--inspect accepts finite seconds > 0 and <= 3600. Captures during the window only;
use --reload to catch startup events. Collection includes raw CDP console/error events,
HTTP >= 400 responses and loadingFailed events. Page actions require a page target.
CDP may replay buffered console/log entries when their domains are enabled.
Evaluation awaits promises and fails on JavaScript exceptions. CDP commands time out after 5s.

Environment: OPENCODE_BROWSER_TEST_PORT, OPENCODE_BROWSER_TEST_START_TIMEOUT (seconds),
OPENCODE_BROWSER_TEST_TEMPLATE_PROFILE, OPENCODE_BROWSER_TEST_ALLOW_TEMPLATE_PROFILE=1,
OPENCODE_BROWSER_PROFILE_DIR, OPENCODE_CHROME_PATH.
Default profile: .opencode/browser-mcp-profile; template: browser-mcp-template/profile.
--launch resets the dedicated profile from the template. Node with built-in WebSocket is required.
macOS launch/close also require python3 on PATH (standard-library ctypes; no packages).
`;

function parseArgs(args) {
  const withValues = new Set(["--launch", "--tampermonkey-install", "--tampermonkey-delete", "--target", "--eval", "--screenshot", "--inspect", "--navigate"]);
  const withoutValues = new Set(["--help", "--status", "--check", "--close", "--pages", "--reload"]);
  const out = {};
  for (let i = 0; i < args.length; i++) {
    const flag = args[i];
    if (!withValues.has(flag) && !withoutValues.has(flag)) throw new Error(`Unknown option: ${flag}`);
    if (Object.hasOwn(out, flag)) throw new Error(`Duplicate option: ${flag}`);
    if (withValues.has(flag)) {
      const value = args[++i];
      if (!value || value.startsWith("--")) throw new Error(`${flag} requires a value`);
      out[flag] = value;
    } else out[flag] = true;
  }
  const commands = ["--help", "--launch", "--status", "--check", "--close", "--pages", "--tampermonkey-install", "--tampermonkey-delete", "--target"].filter((flag) => Object.hasOwn(out, flag));
  if (commands.length !== 1) throw new Error("Choose exactly one command; see --help");
  const actions = ["--eval", "--screenshot", "--inspect", "--navigate"].filter((flag) => Object.hasOwn(out, flag));
  if (commands[0] === "--target") {
    if (!actions.length) throw new Error("--target requires an action");
  } else if (actions.length || out["--reload"]) throw new Error("Inspection actions require --target <exact-id>");
  if (out["--reload"] && !out["--inspect"]) throw new Error("--reload requires --inspect");
  if (out["--inspect"]) {
    const seconds = Number(out["--inspect"]);
    if (!Number.isFinite(seconds) || seconds <= 0 || seconds > 3600) throw new Error("--inspect seconds must be > 0 and <= 3600");
    out["--inspect"] = seconds;
  }
  for (const flag of ["--launch", "--tampermonkey-install", "--navigate"]) {
    if (out[flag]) {
      try { new URL(out[flag]); } catch { throw new Error(`${flag} requires an absolute URL`); }
    }
  }
  return out;
}

async function targetActions(number, options) {
  const target = (await targets(number)).find((item) => item.id === options["--target"] && item.webSocketDebuggerUrl);
  if (!target) throw new Error(`Inspectable target not found: ${options["--target"]}`);
  if ((options["--navigate"] || options["--reload"] || options["--screenshot"]) && target.type !== "page") throw new Error("Navigation, reload and screenshot require a page target");
  const client = await cdp(target.webSocketDebuggerUrl);
  try {
    const result = { target: target.id };
    if (options["--inspect"]) result.inspection = await inspect(client, options["--inspect"], { reload: options["--reload"], navigate: options["--navigate"] });
    else if (options["--navigate"]) {
      await client.send("Page.enable");
      const navigation = await client.send("Page.navigate", { url: options["--navigate"] });
      if (navigation.errorText) throw new Error(navigation.errorText);
      result.navigation = navigation;
    }
    if (Object.hasOwn(options, "--eval")) result.value = await evaluateClient(client, options["--eval"]);
    if (options["--screenshot"]) {
      const screenshot = await client.send("Page.captureScreenshot", { format: "png" });
      const file = path.resolve(expandHome(options["--screenshot"]));
      fs.writeFileSync(file, Buffer.from(screenshot.data, "base64"));
      result.screenshot = file;
    }
    return result;
  } finally {
    client.ws.close();
  }
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args["--help"]) { console.log(HELP); return 0; }
  const profile = profileDir();
  const number = port();
  if (!Number.isInteger(number) || number < 1 || number > 65535) throw new Error("OPENCODE_BROWSER_TEST_PORT must be an integer from 1 to 65535");
  if (!Number.isFinite(START_TIMEOUT) || START_TIMEOUT <= 0 || START_TIMEOUT > 3600000) throw new Error("OPENCODE_BROWSER_TEST_START_TIMEOUT must be > 0 and <= 3600 seconds");
  if (args["--close"]) {
    await terminateProfile(profile, number);
    return 0;
  }

  const launchUrl = args["--launch"];
  const installUrl = args["--tampermonkey-install"];
  const deleteName = args["--tampermonkey-delete"];
  const needsChrome = args["--status"] || args["--check"] || launchUrl || installUrl || deleteName;
  const chrome = needsChrome ? chromePath() : null;

  if (args["--status"] || args["--check"]) console.log(JSON.stringify(await status(chrome, profile, number), null, 2));
  else if (launchUrl) {
    await launchBrowser(chrome, profile, number, launchUrl);
    console.log(JSON.stringify(await status(chrome, profile, number), null, 2));
  } else if (installUrl) console.log(JSON.stringify(await installTampermonkey(profile, number, installUrl), null, 2));
  else if (deleteName) console.log(JSON.stringify(await deleteTampermonkey(profile, number, deleteName), null, 2));
  else if (args["--pages"]) {
    await requireDevtools(number);
    console.log(JSON.stringify((await targets(number)).filter((target) => target.webSocketDebuggerUrl).map(({ id, type, url, title }) => ({ id, type, url, title })), null, 2));
  } else {
    await requireDevtools(number);
    console.log(JSON.stringify(await targetActions(number, args), null, 2));
  }
  return 0;
}

main().then((code) => { process.exitCode = code; }).catch((error) => {
  console.error(`browser-test: ${error.message}`);
  process.exitCode = 1;
});
