#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys
from pathlib import Path


def output(*cmd):
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else ""


def resolve(path):
    src = output("chezmoi", "source-path", path)
    if not src:
        added = subprocess.run(
            ["chezmoi", "add", "--force", path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if added.returncode != 0:
            print(f"czsrc: {path} not managed", file=sys.stderr)
            return None
        src = output("chezmoi", "source-path", path)
    if not src:
        print(f"czsrc: {path} not managed", file=sys.stderr)
        return None
    return src


def run_ai(tmpl, dest):
    model = os.environ.get("CZSRC_AI_MODEL")
    srcdir = output("chezmoi", "source-path") or str(Path.home() / ".local" / "share" / "chezmoi")
    prompt = (
        f"Read chezmoi template {tmpl} and destination {dest}. "
        f"Run chezmoi diff {dest}, then edit the template to match the destination. "
        "Preserve all conditionals, includes, loops, and OS checks. "
        "Do not edit the destination."
    )
    return subprocess.run([
        "opencode",
        "run",
        *(["--model", model] if model else []),
        prompt,
    ], cwd=srcdir).returncode


def sync(dest_path):
    src = resolve(dest_path)
    if not src:
        return 1
    if src.endswith(".tmpl"):
        print(f"{dest_path} -> {src} (AI)")
        return run_ai(src, str(Path(dest_path).expanduser().resolve()))
    print(f"{dest_path} -> {src}")
    try:
        shutil.copy2(Path(dest_path).expanduser(), src)
    except OSError as e:
        print(f"  failed: {e}")
        return 1
    print("  copied")
    return 0

if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
    print("Usage: czsrc [path ...]")
    raise SystemExit(0)

if len(sys.argv) > 1:
    paths = sys.argv[1:]
else:
    p = subprocess.run(
        ["chezmoi", "status", "--include=files", "--path-style=absolute"],
        capture_output=True, text=True,
    )
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
        raise SystemExit(p.returncode)
    paths = []
    for line in p.stdout.splitlines():
        if len(line) < 4 or line[0] not in "AM" or line[1] == "D":
            continue
        dest = line[3:]
        if output("chezmoi", "source-path", dest):
            paths.append(dest)

if not paths:
    print("No edited home files to sync.")
    raise SystemExit(0)

failed = 0
for path in paths:
    if sync(path) != 0:
        failed += 1

print(f"Done: {len(paths) - failed} files synced, {failed} failed")
raise SystemExit(1 if failed else 0)
